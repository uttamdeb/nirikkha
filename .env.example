# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx          # server only, never ship to the browser
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Models (both swappable, see README) ----
OCR_PROVIDER=gemini                         # gemini | documentai | vision | stub
OCR_MODEL=gemini-3.7-flash
GRADER_PROVIDER=openai                      # openai | openrouter | stub
GRADER_MODEL=gpt-5.6-luna
GRADER_REASONING_EFFORT=high   # high | medium | low | "" to disable

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ---- Gate ----
LEGIBILITY_THRESHOLD=0.65                   # calibrate against reference scripts

# ---- Classroom / Telegram ----
APP_URL=https://your-public-host.example    # used by setWebhook (ngrok ok locally)
SETTINGS_ENCRYPTION_KEY=                    # 64-hex or any string (SHA-256'd); encrypts bot token

# ---- Web (Vite, public) ----
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_API_BASE_URL=http://localhost:8080
